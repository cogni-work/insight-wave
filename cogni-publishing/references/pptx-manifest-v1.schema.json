{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cogni-publishing/pptx-manifest-v1",
  "title": "pptx-manifest@1",
  "description": "What one design-render PPTX run placed in its deck: every object on every slide with its kind, editability, capability and the copy it carries; every fallback with its capability and reason; and the identities a deck is audited by — package digest, writer and runtime, design system and revision, theme tokens, fonts and each embedded asset. It is renderer output like render-provenance@1, not a chain artifact, so the validator's SUPPORTED/COMPATIBLE maps do not list it. design-render.py check-pptx is the checker and cross-checks every object against the package itself; references/design-render.md explains each field.",
  "type": "object",
  "required": ["artifact_type", "artifact_version", "artifact_id", "package", "slide_size", "writer", "runtime", "design_system", "theme", "language", "fonts", "readability", "assets", "slides", "fallbacks"],
  "properties": {
    "artifact_type": {"const": "pptx-manifest"},
    "artifact_version": {"const": "1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "composition_ref": {"$ref": "#/$defs/ref"},
    "plan_ref": {"$ref": "#/$defs/ref"},
    "package": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"const": "deck.pptx"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "slide_size": {
      "type": "object",
      "required": ["unit", "cx", "cy"],
      "properties": {"unit": {"const": "emu"}, "cx": {"const": 12192000}, "cy": {"const": 6858000}}
    },
    "writer": {
      "type": "object",
      "required": ["name", "version"],
      "description": "The writer is design-render itself; version is the plugin version read at render time and must equal the provenance renderer version.",
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "adapter": {"type": "string"}}
    },
    "runtime": {
      "type": "object",
      "required": ["name", "version"],
      "description": "The interpreter that ran the writer, read from the running process.",
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "design_system": {
      "type": "object",
      "required": ["name", "version"],
      "description": "The composition's pinned design system and its revision, unchanged.",
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "theme": {
      "type": "object",
      "required": ["slug", "tokens_sha256"],
      "properties": {"slug": {"type": "string"}, "tokens_sha256": {"$ref": "#/$defs/digest"}}
    },
    "language": {"type": "string"},
    "fonts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["token", "requested_stack", "requested_family", "resolved_face", "typeface", "substituted", "fallback_chain", "source"],
        "properties": {
          "token": {"type": "string"},
          "requested_stack": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requested_family": {"type": "string"},
          "resolved_face": {"type": "string", "minLength": 1},
          "typeface": {"type": "string", "minLength": 1, "description": "The Office typeface the deck names: a bundled face, or the resolved generic family's pptx_typeface."},
          "substituted": {"type": "boolean"},
          "skipped": {"type": "array", "items": {"type": "string"}},
          "fallback_chain": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source": {"enum": ["bundled", "generic"]}
        }
      }
    },
    "readability": {
      "type": "object",
      "required": ["min_sz", "token", "autofit"],
      "properties": {
        "min_sz": {"type": "integer", "description": "The smallest run size, in hundredths of a point: the theme's caption size."},
        "token": {"const": "typography.size-small"},
        "autofit": {"const": "none"}
      }
    },
    "assets": {
      "type": "array",
      "description": "Every embedded part, identified by its own digest rather than the package's: a chart's workbook, and each declared fallback picture's raster and vector media parts.",
      "items": {
        "type": "object",
        "required": ["part", "sha256", "kind", "unit"],
        "properties": {
          "part": {"type": "string", "pattern": "^ppt/(embeddings|media)/"},
          "sha256": {"$ref": "#/$defs/digest"},
          "kind": {"enum": ["chart-workbook", "fallback-raster", "fallback-vector"]},
          "unit": {"type": "string"}
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "part", "name", "unit", "notes_part", "objects"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "part": {"type": "string", "pattern": "^ppt/slides/slide[0-9]+\\.xml$"},
          "name": {"type": "string", "description": "The composition unit id, or document for the cover."},
          "unit": {"type": ["string", "null"]},
          "pattern": {"type": ["string", "null"]},
          "notes_part": {"type": ["string", "null"]},
          "notes_paragraphs": {"type": "integer", "minimum": 0},
          "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}}
        }
      }
    },
    "fallbacks": {"type": "array", "description": "Every image object of every slide — each one a declared fallback — repeated here in slide order; empty for a deck with no picture.", "items": {"$ref": "#/$defs/object"}},
    "generated_at": {"type": "string"},
    "run_id": {"type": "string"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "required": ["artifact_id", "artifact_version"],
      "properties": {"artifact_id": {"type": "string"}, "artifact_version": {"type": "string"}}
    },
    "object": {
      "type": "object",
      "required": ["shape_id", "name", "kind", "editable", "capability", "copy_keys", "fallback"],
      "properties": {
        "shape_id": {"type": "integer", "minimum": 2},
        "name": {"type": "string", "description": "The shape name that addresses its content: copy:<key>, value:<data id>, register:<unit>, cites:<unit>, kind:<from>:<to>, edge:<from>:<to>, rule:<key>, chart:<unit>, figure:<unit>."},
        "kind": {"enum": ["text", "shape", "connector", "chart", "image"]},
        "editable": {"type": "boolean", "description": "True for every native object; false only for an image fallback."},
        "capability": {"enum": ["text-frame", "hyperlink", "editable-shapes", "native-chart", "speaker-notes", "picture-fallback"], "description": "A pptx capability from pattern-library@1."},
        "copy_keys": {"type": "array", "items": {"type": "string"}},
        "data_refs": {"type": "array", "items": {"type": "string"}},
        "fallback": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["capability", "reason"],
              "description": "Present only on an image object: the fallback declaration of the unit's variant in the pattern library, copied unchanged — its target, the capability and why the figure is not native.",
              "properties": {"target": {"type": "string", "minLength": 1}, "capability": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
            }
          ]
        }
      }
    }
  }
}
