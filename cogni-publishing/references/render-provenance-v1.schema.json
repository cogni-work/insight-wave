{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cogni-publishing/render-provenance-v1",
  "title": "render-provenance@1",
  "description": "Platform host execution, frozen inputs, evidence, attempts and independent admission.",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_version",
    "artifact_id",
    "renderer",
    "design_system",
    "content_fingerprint",
    "outputs",
    "inputs",
    "reproducible",
    "live_proof",
    "run",
    "attempts",
    "review",
    "applicability"
  ],
  "properties": {
    "artifact_type": {
      "const": "render-provenance"
    },
    "artifact_version": {
      "const": "1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "renderer": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "target",
        "host"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "enum": [
            "html",
            "pptx"
          ]
        },
        "kind": {
          "const": "platform"
        }
      },
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "marketplace_commit"
          ]
        }
      ]
    },
    "design_system": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": [
        "brief",
        "composition",
        "theme"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "content_fingerprint": {
      "$ref": "#/$defs/digest"
    },
    "reproducible": {
      "type": "boolean",
      "description": "Host-generated artifacts are not byte-reproducible.",
      "const": false
    },
    "outputs": {
      "type": "object",
      "required": [
        "artifact"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "live_proof": {
      "type": "boolean"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "host",
        "skill",
        "live",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "live": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/file",
          "description": "Digest-bound execution JSON with host, skill and boolean live matching this run; check-provenance --out-dir cross-checks the file."
        }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "attempt",
          "findings",
          "preserve",
          "content_fingerprint_before",
          "content_fingerprint_after",
          "unit_ids_before",
          "unit_ids_after"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "findings": {
            "type": "array"
          },
          "preserve": {
            "type": "object",
            "required": [
              "differences"
            ],
            "properties": {
              "differences": {
                "type": "array"
              }
            }
          },
          "content_fingerprint_before": {
            "$ref": "#/$defs/digest"
          },
          "content_fingerprint_after": {
            "$ref": "#/$defs/digest"
          },
          "unit_ids_before": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unit_ids_after": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "open_findings",
        "coverage"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "open_findings": {
          "type": "array",
          "maxItems": 0
        },
        "coverage": {
          "type": "object",
          "required": [
            "all_units",
            "all_slides",
            "overview"
          ],
          "properties": {
            "all_units": {
              "const": true
            },
            "all_slides": {
              "const": true
            },
            "overview": {
              "const": true
            }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "required": [
        "theme",
        "fonts",
        "runtime"
      ],
      "properties": {
        "theme": {
          "type": "object",
          "required": [
            "applicable",
            "evidence",
            "reason"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "applicable": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "fonts": {
          "type": "object",
          "required": [
            "applicable",
            "evidence",
            "reason"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "applicable": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "runtime": {
          "type": "object",
          "required": [
            "applicable",
            "evidence",
            "reason"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "applicable": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
