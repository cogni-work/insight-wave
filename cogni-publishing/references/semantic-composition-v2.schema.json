{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cogni-publishing/semantic-composition-v2",
  "title": "semantic-composition@2",
  "description": "Pattern-bound grouping by reference: ids, digests and semantic relationships only; no copy and no target geometry. Every normalized record, content field, note, evidence label, citation, data item and trailer note is bound exactly once, in authored order. The validator is the enforcer; references/design-composition.md holds the binding rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "artifact_id", "normalized_brief_ref", "pattern_library_ref", "design_system", "targets", "document_bindings", "units"],
  "properties": {
    "artifact_type": {"const": "semantic-composition"},
    "artifact_version": {"const": "2"},
    "artifact_id": {"type": "string", "minLength": 1},
    "normalized_brief_ref": {
      "type": "object",
      "required": ["artifact_id", "artifact_version", "content_fingerprint"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1},
        "content_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "sha256 over the canonical JSON of the brief's document, structure, records, data, sources and freeze."}
      }
    },
    "pattern_library_ref": {"$ref": "#/$defs/artifact_ref"},
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}},
      "description": "The design-system revision pinned as data; the composition resolves no token."
    },
    "targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "document_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "index", "digest"],
        "properties": {"field": {"const": "trailer_notes"}, "index": {"type": "integer", "minimum": 0}, "digest": {"$ref": "#/$defs/digest"}}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "variant", "bindings", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "description": "A short kebab-case semantic role, never copy."},
          "pattern": {"type": "string", "minLength": 1, "description": "An accepted pattern-library pattern id."},
          "variant": {"type": "string", "minLength": 1},
          "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
          "data_bindings": {"type": "array", "items": {"$ref": "#/$defs/data_binding"}, "description": "Chart family only."},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Derived: first-seen citations of the bound records, then of the bound data items."},
          "register_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Register family only: every source id, in original order."},
          "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}, "description": "System family only."},
          "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}, "description": "System family only."},
          "type_floor": {"type": "string", "description": "Optional; may raise the pattern's minimum typography role, never lower it."}
        }
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "artifact_version"],
      "properties": {"artifact_id": {"type": "string", "minLength": 1}, "artifact_version": {"type": "string", "minLength": 1}}
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "record_ref", "field", "digest"],
      "properties": {"slot": {"type": "string", "minLength": 1}, "record_ref": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "data_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "data_ref"],
      "properties": {"slot": {"type": "string", "minLength": 1}, "data_ref": {"type": "string", "minLength": 1}}
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "record_ref", "field"],
      "properties": {"id": {"type": "string", "minLength": 1}, "record_ref": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}, "item": {"type": "integer", "minimum": 0}}
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}
    }
  }
}
