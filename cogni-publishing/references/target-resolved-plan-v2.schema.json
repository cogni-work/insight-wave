{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cogni-publishing/target-resolved-plan-v2",
  "title": "target-resolved-plan@2",
  "description": "A renderer's layout of one semantic-composition@2 for one target: a canvas, a frame per unit and a box, type role and measured face per slot. Content is referenced by the composition's own ids and digests; the plan carries no copy. validate-publishing.py check-plan is the enforcer; references/design-render.md holds the layout rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "artifact_id", "composition_ref", "normalized_brief_ref", "pattern_library_ref", "target", "design_system", "canvas", "document_bindings", "units", "generated_at", "run_id"],
  "properties": {
    "artifact_type": {"const": "target-resolved-plan"},
    "artifact_version": {"const": "2"},
    "artifact_id": {"type": "string", "minLength": 1},
    "composition_ref": {"$ref": "#/$defs/artifact_ref", "description": "Must name the supplied semantic-composition@2."},
    "normalized_brief_ref": {
      "type": "object",
      "required": ["artifact_id", "artifact_version", "content_fingerprint"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1},
        "content_fingerprint": {"$ref": "#/$defs/digest"}
      }
    },
    "pattern_library_ref": {"$ref": "#/$defs/artifact_ref"},
    "target": {"type": "string", "minLength": 1, "description": "One of the composition's targets."},
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}},
      "description": "The composition's pin, unchanged."
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "width", "height"],
      "properties": {"unit": {"const": "px"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    },
    "document_bindings": {"type": "array", "description": "The composition's document_bindings, unchanged."},
    "units": {
      "type": "array",
      "description": "Exactly one per composition unit, in composition order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["composition_unit_ref", "pattern", "variant", "frame", "slots"],
        "properties": {
          "composition_unit_ref": {"type": "string", "minLength": 1},
          "pattern": {"type": "string", "minLength": 1},
          "variant": {"type": "string", "minLength": 1},
          "frame": {"$ref": "#/$defs/box"},
          "slots": {
            "type": "array",
            "description": "The pattern's slots that carry content, in its reading order.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot", "placement", "box", "type_role", "measured_with", "lines", "content"],
              "properties": {
                "slot": {"type": "string", "minLength": 1},
                "placement": {"enum": ["canvas", "aside"]},
                "box": {"oneOf": [{"$ref": "#/$defs/box"}, {"type": "null"}], "description": "null for an aside slot."},
                "type_role": {"type": "string", "description": "A pattern-library type_scale role, not below the pattern's minimum on the canvas."},
                "measured_with": {"type": "string", "minLength": 1, "description": "The resolved face the line estimate used."},
                "lines": {"type": "integer", "minimum": 0},
                "content": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["digest"],
                    "properties": {
                      "record_ref": {"type": "string"},
                      "field": {"type": "string"},
                      "data_ref": {"type": "string"},
                      "source_ref": {"type": "string"},
                      "digest": {"$ref": "#/$defs/digest"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "generated_at": {"type": "string", "description": "Volatile: ignored by the comparator."},
    "run_id": {"type": "string", "description": "Volatile: ignored by the comparator."}
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "artifact_version"],
      "properties": {"artifact_id": {"type": "string", "minLength": 1}, "artifact_version": {"type": "string", "minLength": 1}}
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
