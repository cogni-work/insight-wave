{
  "id": "timeline-sequence",
  "status": "proposed",
  "family": "system",
  "purpose": "Show independent events converging on one deadline, so the audience sees the window closing rather than a list of dates.",
  "eligibility": {
    "when": "A timeline unit names events or forces whose convergence on one moment is the point.",
    "record_kinds": ["slide", "section"],
    "slide_types": ["timeline"],
    "data": "forbidden"
  },
  "slots": [
    {"id": "claim", "accepts": ["headline"], "required": true, "max_items": 1, "max_chars": 140},
    {"id": "entities", "accepts": ["points", "headline", "body"], "required": true, "min_items": 2, "max_items": 6, "max_chars": 90},
    {"id": "evidence", "accepts": ["evidence"], "required": false},
    {"id": "notes", "accepts": ["notes"], "required": false}
  ],
  "constraints": {"min_type_role": "type.body", "min_records": 1, "max_records": 1},
  "evidence_needs": {"citations": "carry-all", "evidence_status": "carry-when-present", "dataset": "none", "provenance": "none"},
  "accessibility": {"role": "figure", "reading_order": ["claim", "entities", "evidence", "notes"], "text_alternative": "entity-list"},
  "target_capabilities": {"html": ["svg-figure", "aside-notes"], "pptx": ["editable-shapes", "speaker-notes"]},
  "variants": [
    {"id": "sequence", "purpose": "Events that follow or converge on one another.", "relationships": ["precedes", "converges-with"]}
  ],
  "examples": [
    {
      "id": "timeline-sequence-slide",
      "brief": {
        "input_kind": "narrative",
        "records": [
          {"id": "slide-1", "order": 1, "kind": "slide", "headline": "Two deadlines meet in 2027", "fields": [
            {"key": "type", "kind": "scalar", "value": "timeline"},
            {"key": "slide_points", "kind": "list", "value": ["Regulation applies from January 2027", "Insurers reprice in 2027"]},
            {"key": "talk_track", "kind": "prose", "value": "Both land in the same year."}
          ], "source_refs": []}
        ],
        "data": [],
        "sources": []
      },
      "unit": {
        "id": "u-timeline",
        "pattern": "timeline-sequence",
        "variant": "sequence",
        "bindings": [
          {"slot": "claim", "record_ref": "slide-1", "field": "headline"},
          {"slot": "entities", "record_ref": "slide-1", "field": "slide_points"},
          {"slot": "notes", "record_ref": "slide-1", "field": "talk_track"}
        ],
        "entities": [
          {"id": "e1", "record_ref": "slide-1", "field": "slide_points", "item": 0},
          {"id": "e2", "record_ref": "slide-1", "field": "slide_points", "item": 1}
        ],
        "relationships": [{"from": "e1", "to": "e2", "kind": "converges-with"}]
      }
    }
  ]
}
